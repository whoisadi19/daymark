{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DAYMARK",
  "version": "1.0.0",
  "identifier": "com.daymark.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DAYMARK",
        "width": 960,
        "height": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0A0A0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "shortDescription": "Personal Execution & Desk Telemetry",
    "longDescription": "DAYMARK is a keyboard-driven personal execution and desk-telemetry application with a dark frosted aesthetic and a compact always-on-top desktop mini-widget.",
    "category": "Utility",
    "copyright": "2026 DAYMARK",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
